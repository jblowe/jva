# systemd unit for the search app: /etc/systemd/system/jva.service
# Paths assume the repository is cloned to /home/ubuntu/jva with a venv inside it.
[Unit]
Description=Voelker Archive search app (jva.johnblowe.com)
After=network.target

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/jva/webapp
Environment=JVA_CONFIG=/home/ubuntu/jva/config.json
ExecStart=/home/ubuntu/jva/venv/bin/gunicorn -c /home/ubuntu/jva/deploy/gunicorn.conf.py wsgi:app
ExecReload=/bin/kill -s HUP $MAINPID
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
